SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 6 * * * root /usr/bin/python3 /home/frappe/scripts/check-press-agent-certs.py >> /var/log/press-cert-audit.log 2>&1
