   "in_list_view": 1,
   "label": "Evaluation Mode",
   "options": "Field Comparison\nPython Expression\nPython Script\nPython Method",
   "reqd": 1
  },
  {
   "depends_on": "eval:doc.evaluation_mode=='Field Comparison'",
   "description": "Fieldname on the target DocType to compare",
   "fieldname": "condition_field",
   "fieldtype": "Data",
   "label": "Field Name",
   "mandatory_depends_on": "eval:doc.evaluation_mode=='Field Comparison'"
  },
  {
   "depends_on": "eval:doc.evaluation_mode=='Field Comparison'",
   "fieldname": "condition_operator",
   "fieldtype": "Select",
   "label": "Operator",
   "mandatory_depends_on": "eval:doc.evaluation_mode=='Field Comparison'",
   "options": "\n>\n>=\n<\n<=\n==\n!=\nin\nnot in\nis set\nis not set"
  },
  {
   "depends_on": "eval:doc.evaluation_mode=='Field Comparison' && !['is set', 'is not set'].includes(doc.condition_operator)",
