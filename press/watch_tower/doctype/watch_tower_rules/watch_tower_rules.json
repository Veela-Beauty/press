   "fieldname": "condition_value",
   "fieldtype": "Data",
   "label": "Value"
  },
  {
   "depends_on": "eval:doc.evaluation_mode=='Python Expression'",
   "description": "Single-line Python expression. Variable 'doc' has all document fields. e.g. doc.custom_dms_outstanding_balance > 50000",
   "fieldname": "condition_expression",
   "fieldtype": "Code",
   "label": "Condition (Python Expression)",
   "mandatory_depends_on": "eval:doc.evaluation_mode=='Python Expression'",
   "options": "Python"
  },
  {
   "depends_on": "eval:doc.evaluation_mode=='Python Script'",
   "description": "Multi-line Python script. Set 'result = True' if the document matches. Variables: doc, frappe, flt, cint, json",
   "fieldname": "condition_script",
   "fieldtype": "Code",
   "label": "Condition (Python Script)",
   "mandatory_depends_on": "eval:doc.evaluation_mode=='Python Script'",
   "options": "Python"
  },
  {
   "depends_on": "eval:doc.evaluation_mode=='Python Method'",
   "description": "Dotted Python path to a function. e.g. press.watch_tower.rules.high_credit_risk",
   "fieldname": "condition_method",
   "fieldtype": "Select",
   "label": "Python Method",
   "mandatory_depends_on": "eval:doc.evaluation_mode=='Python Method'"
  },
  {
